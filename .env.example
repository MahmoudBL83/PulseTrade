# Copy to .env and fill. Never commit .env.

# --- core secrets (required in production) ---------------------------------------
SECRET_KEY=change-me-dev-only
JWT_SECRET_KEY=change-me-dev-only-use-32+-random-chars
SECURITY_PASSWORD_SALT=change-me-dev-only
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-with-python-cryptography-fernet
DATABASE_URL=sqlite:///crypto.db
REDIS_URL=redis://127.0.0.1:6379
FRONTEND_URL=https://pulse-trade-zeta.vercel.app

# --- admin -------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_STREAM_PASSWORD=
# Base32 secret for an authenticator app (recommended): python -c "import pyotp;print(pyotp.random_base32())"
ADMIN_TOTP_SECRET=

# --- mail (OTP, password reset, verification) ---------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
REQUIRE_EMAIL_VERIFICATION=0

# --- payments ------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
TAP_API_KEY=
TAP_CURRENCY=KWD

# --- engine: who runs bots / smart trades / alerts / paper orders ---------------------
# scheduler (in-process, default for run.py) | celery (legacy loops) | cron (serverless) | off
ENGINE=scheduler
ENGINE_INTERVAL=15
START_SCHEDULER=0
# Protects /api/cron/* (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=
CRON_BUDGET_SECONDS=8

# --- market data (public, no keys) ---------------------------------------------------
# auto (live with fallbacks, synthetic if offline) | live | synthetic
MARKET_DATA=auto
MARKET_DATA_EXCHANGE=binance
MARKET_DATA_FALLBACKS=okx,kucoin,bybit
# ccxt.pro websocket streaming of live tickers (long-running servers only)
MARKET_STREAM=0
MARKET_STREAM_SYMBOLS=40
# CoinGecko / alternative.me / DefiLlama context data: auto | off
EXTERNAL_DATA=auto
# Optional free CoinGecko Demo key (higher rate limits than keyless)
COINGECKO_API_KEY=

# --- notifications ----------------------------------------------------------------------
# Bot token for Telegram delivery (users add their chat id in Settings)
TELEGRAM_BOT_TOKEN=

# --- misc -------------------------------------------------------------------------------
GOOGLE_API_KEY=
HF_TOKEN=
VERCEL=
DEMO=0
TRUST_PROXY=0
LOG_LEVEL=INFO
